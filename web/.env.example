# Copy this file to .env.local for local development.
# Set the same names in the Vercel project (Production and Preview).

NEXT_PUBLIC_APP_NAME=RideSync
NEXT_PUBLIC_APP_ENV=development

# Optional origin used by the health page when fetching /api/health.
# Leave empty locally (defaults to http://localhost:3000).
# On Vercel, VERCEL_URL is used if this is unset.
NEXT_PUBLIC_APP_URL=

# Reserved for a future RideSync API. Leave empty for now.
NEXT_PUBLIC_API_BASE_URL=

# Optional extra URL for the health page to ping.
# If empty, the page only checks same-origin /api/health.
HEALTHCHECK_URL=
